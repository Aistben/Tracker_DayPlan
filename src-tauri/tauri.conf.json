{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tracker DayPlan",
  "version": "0.1.0",
  "identifier": "ru.tracker.dayplan",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tracker DayPlan",
        "width": 1000,
        "height": 720,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
